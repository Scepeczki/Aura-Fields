{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aura Fields",
  "version": "../package.json",
  "identifier": "pl.scepeczki.aurafields",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Scepeczki",
    "copyright": "© Scepeczki",
    "category": "Game",
    "shortDescription": "Gra o gospodarstwie i młynie",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Polish"
        ],
        "installerIcon": "icons/icon.ico",
        "headerImage": "windows/header.bmp",
        "sidebarImage": "windows/sidebar.bmp",
        "installerHooks": "windows/hooks.nsh",
        "customLanguageFiles": {
          "Polish": "windows/Polish.nsh"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBFQzUzNjE2RDNDN0VCQzgKUldUSTY4ZlRGamJGRHNqVDFTQ3VQcDFicU1QWWpja1RkNkJmSUk1Z1NOTjVVNzFaRTRsWmhYRXcK",
      "endpoints": [
        "https://github.com/Scepeczki/Aura-Fields/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
